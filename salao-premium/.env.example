# =====================================================================
#  Copie para .env.local e preencha. NUNCA versione o .env.local.
# =====================================================================

# URL pública do site (usada em SEO, sitemap, Open Graph e links)
NEXT_PUBLIC_SITE_URL=https://www.seusalao.com.br

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon / publishable). Pode ir ao navegador: o acesso é limitado por RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (service_role / secret). SOMENTE servidor. Nunca use prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
#  Opcional: e-mail de confirmação via Resend (https://resend.com)
#  Sem estas variáveis o site funciona normalmente e NÃO envia e-mails.
# ---------------------------------------------------------------------
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "Atelier Aurea <agenda@seusalao.com.br>"
EMAIL_FROM=
# Opcional: recebe uma cópia de cada novo agendamento
ADMIN_NOTIFICATION_EMAIL=
